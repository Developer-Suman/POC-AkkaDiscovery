akka {
  # Local development: bind to loopback only
  actor.provider = cluster
  actor.telemetry.enabled = on

  remote.dot-netty.tcp {
    hostname = "127.0.0.1"
    port = 4055
  }

  # Local bootstrap via Akka.Discovery config provider
  discovery {
    method = config

    config {
      class = "Akka.Discovery.Config.ConfigServiceDiscovery, Akka.Discovery"
      services {
        fraud-detection-bootstrap {
          endpoints = [
            { host = "127.0.0.1", port = 8558 },
            { host = "127.0.0.1", port = 8559 },
            { host = "127.0.0.1", port = 8560 }
          ]
        }
      }
    }
  }

  management {
    http {
      hostname = "127.0.0.1"
      port = 8558
    }

    cluster.bootstrap.contact-point-discovery {
      service-name = "fraud-detection-bootstrap"
      discovery-method = config
      required-contact-point-nr = 1
      contact-point-fallback-port = 8558
    }
  }
}

petabridge.cmd {
  host = "127.0.0.1"
  port = 9112
  log-info = on
}
