akka {
  actor.provider = cluster
  actor.telemetry.enabled = on

  # Production: bind to all interfaces so Kubernetes can route traffic
  remote.dot-netty.tcp {
    hostname = "0.0.0.0"
    port = 4055
  }

  discovery {
    method = kubernetes-api

    kubernetes-api {
      class = "Akka.Discovery.KubernetesApi.KubernetesApiServiceDiscovery, Akka.Discovery.KubernetesApi"
      pod-namespace = "ppm-cpe-qa"
      pod-label-selector = "app.kubernetes.io/instance=cpe-poc"
    }
  }

  management {
    http {
      hostname = "0.0.0.0"
      port = 8558
    }

    cluster.bootstrap.contact-point-discovery {
      service-name = "cpe-poc-helm-batchportal"
      discovery-method = kubernetes-api
      required-contact-point-nr = 1
      contact-point-fallback-port = 8558
    }
  }

  # Split Brain Resolver: automatically down unreachable nodes in a network partition.
  # keep-majority keeps the partition with more nodes; the minority partition downs itself.
  cluster {
    downing-provider-class = "Akka.Cluster.SBR.SplitBrainResolverProvider, Akka.Cluster"
    split-brain-resolver {
      active-strategy = keep-majority
      stable-after = 20s
      down-all-when-unstable = on
    }
  }
}

petabridge.cmd {
  host = "0.0.0.0"
  port = 9112
  log-info = on
}
