akka {
  actor.provider = cluster

  remote.dot-netty.tcp {
    hostname = "0.0.0.0"
    port = 4055
  }
  
  # INFO (not DEBUG) - akka.cluster.log-info = on below already surfaces discovery/join/member-up
  # events at INFO level; DEBUG adds so much DNS/actor-internal noise that those events get buried
  # and truncated out of any reasonably-sized log capture.
  loglevel = INFO
  stdout-loglevel = INFO

  io.dns {
    resolver = async-dns
    async-dns {
      class = "Akka.Discovery.Dns.Internal.DnsClient, Akka.Discovery.Dns"
      provider-object = "Akka.Discovery.Dns.Internal.AsyncDnsProvider, Akka.Discovery.Dns"
      nameservers = []
      cache-cleanup-interval = 120s
      positive-ttl = forever
    }
  }

  discovery {
    method = aggregate
    aggregate.discovery-methods = [kubernetes-api, akka-dns, config]

    akka-dns {
      class = "Akka.Discovery.Dns.DnsServiceDiscovery, Akka.Discovery.Dns"
      resolve-timeout = 5s
      verbose-failure-logging = on
    }

    kubernetes-api {
      class = "Akka.Discovery.KubernetesApi.KubernetesApiServiceDiscovery, Akka.Discovery.KubernetesApi"
      api-ca-path = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
      api-token-path = "/var/run/secrets/kubernetes.io/serviceaccount/token"
      api-service-host-env-name = "KUBERNETES_SERVICE_HOST"
      api-service-port-env-name = "KUBERNETES_SERVICE_PORT"
      pod-namespace-path = "/var/run/secrets/kubernetes.io/serviceaccount/namespace"
      pod-namespace = "ppm-cpe-qa"
      pod-domain = "cluster.local"
      pod-label-selector = "cluster=nucleus-rule-services"
      use-raw-ip = true
      container-name = ""
    }

    config {
      class = "Akka.Discovery.Config.ConfigServiceDiscovery, Akka.Discovery"
      services {}
    }
    
  }

  # cluster.bootstrap.contact-point-discovery is deliberately NOT set here - WithClusterBootstrap(...)
  # in Program.cs passes service-name/service-namespace/port-name/required-contact-point-nr explicitly,
  # via a strongly-typed Setup object that takes priority over HOCON regardless of what's set here.
  # Setting it in this file too would be misleading dead config.

  cluster {
    log-info = on
    downing-provider-class = "Akka.Cluster.SBR.SplitBrainResolverProvider, Akka.Cluster"
    split-brain-resolver {
      active-strategy = keep-majority
      stable-after = 20s
      down-all-when-unstable = on
    }
    roles = ["batchportal"]
  }
}



petabridge.cmd {
  host = "0.0.0.0"
  port = 9112
  log-info = on
}