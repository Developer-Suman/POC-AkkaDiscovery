using BatchProcessor;
using Akka.Hosting;

var builder = Host.CreateApplicationBuilder(args);

builder.Services.AddAkka("FraudDetectionActorSystem", (akkaBuilder, provider) =>
{
    var hocon = provider.GetRequiredService<IConfiguration>()["Akka:Hocon"];

    if (!string.IsNullOrWhiteSpace(hocon))
    {
        akkaBuilder.AddHocon(hocon, HoconAddMode.Prepend);
    }
});

builder.Services.AddHostedService<Worker>();

var host = builder.Build();
host.Run();
